      "input": {
        "hour": 9,
        "dayOfWeek": 1,
        "motionState": "stationary",
        "wifiSsid": "Company-WiFi-5G",
        "btDeviceNames": "JBL Flip 5",
        "btFixedDevices": "JBL Flip 5",
        "geofence": "office",
        "batteryLevel": 85,
        "isCharging": false,
        "screenState": "on",
        "networkType": "wifi"
      },
      "expected": {
        "tier": 1,
        "motionState": "stationary",
        "timeOfDay": "morning",
        "wifiMobility": "fixed",
        "geofenceAssociated": true
      }
    },
    {
