[
  {
    "id": "rule_morning_workday",
    "name": "工作日早出门",
    "conditions": [
      {
        "key": "timeOfDay",
        "op": "eq",
        "value": "morning"
      },
      {
        "key": "isWeekend",
        "op": "eq",
        "value": "false"
      },
      {
        "key": "motionState",
        "op": "in",
        "value": "walking,driving"
      }
    ],
    "action": {
      "id": "suggest_morning_commute",
      "type": "suggestion",
      "payload": "早上好！查看通勤路线和天气？"
    },
    "priority": 2.0,
    "cooldownMs": 14400000,
    "enabled": true
  },
  {
